# Server & App Configuration
APP_NAME=Universal Bank Statement Analyzer
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# OCR Configuration
# If TESSERACT_CMD is not specified, system automatically detects standard Windows installations and PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
DEFAULT_OCR_ENGINE=tesseract
OCR_DPI=300
OCR_TIMEOUT_SECONDS=60

# Security Limits
MAX_FILE_SIZE_BYTES=26214400
MAX_PAGE_COUNT=100
